# 后端环境变量模板（agentic-app）
#
# 用法：
#   cp .env.example .env        # .env 已被 .gitignore 忽略，不会进仓库
#   然后按环境改值；app.py 启动时会用 python-dotenv 读取它
#   （已存在的系统环境变量优先，docker-compose / systemd 注入的值不会被覆盖）
#
# 两个约定：
#   1. 空字符串按"未设置"处理：compose 的 ${VAR:-} 会传空串，
#      各配置模块都会 strip 后判空再回退默认值，不会把默认值冲掉。
#   2. **注释一律单独成行，不要写在 KEY=value 后面**：python-dotenv 会把
#      `KEY=  # 说明` 里的 `# 说明` 当成值的一部分。
#      这也是本文件里所有说明都在上一行的原因。

# ============================================================
# 大模型（models/llm.py，唯一模型配置）
# ============================================================
# openai（OpenAI 兼容接口：DeepSeek / 硅基流动 / vLLM / LM Studio）或 ollama
LLM_TYPE=openai
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
# 下面两个二选一即可，不用都填：LLM_API_KEY 优先，留空才回退 OPENAI_API_KEY。
#   LLM_API_KEY     项目自有命名，和 LLM_TYPE/LLM_BASE_URL/LLM_MODEL 成一套，新代码走它
#   OPENAI_API_KEY  OpenAI 生态约定名；agent/intent/generate_intent_examples.py
#                   这类老脚本只认它，所以保留兼容，别删
# 建议只填 OPENAI_API_KEY：LLM 链路会回退读到它，老脚本也能用。
LLM_API_KEY=
OPENAI_API_KEY=
# low / high / max；off = 不传该字段（不等于关闭思考）
LLM_REASONING_EFFORT=low
# enabled / disabled：DeepSeek 真正关闭思考走这个
LLM_THINKING=disabled

# ============================================================
# MCP sidecar（mcp_client/mcp_config.py）
# 优先级：MCP_BASE_URL > mcp_server_config.yaml 顶层的 mcp_base_url
# 容器内写 http://mcp-sidecar:2223/mcp；本机连宿主机写 http://10.204.146.44:2223/mcp
# ============================================================
MCP_BASE_URL=http://10.204.146.44:2223/mcp
# 场景端点单独覆盖；不配则读 yaml 里 scene 条目
SCENE_MCP_URL=

# ============================================================
# 知识库检索（mcp_client/knowledge_http_client.py）
# 配了 KB_BASE_URL + KB_API_KEY 就走平台检索接口直连（不经 sidecar）；
# 两个都不配则退回 sidecar /mcp/knowledge。字段口径见该模块文档。
# ============================================================
# 例：http://10.204.146.44:8082
KB_BASE_URL=
# 平台给的 Bearer 值，例：dataset-xxxxxxxx
KB_API_KEY=
KB_RETRIEVAL_PATH=/v1/api_key/datasets/draft
# 知识库 ID，英文逗号分隔；留空 = 不指定范围
KB_DATASET_IDS=
KB_TOP_K=5
# 例：0.13；留空则不传该字段
KB_SCORE_THRESHOLD=
# 0 = 关闭重排
KB_RERANK_ENABLE=1
KB_RERANK_PROVIDER=tong_yi
KB_RERANK_MODEL=gte-rerank
KB_TIMEOUT=20
# 单条片段喂给模型时的最大字符数，防止撑爆上下文
KB_SEGMENT_MAX_CHARS=800
# 混合检索权重，对应平台界面 Hybrid Search 的「SEMANTIC x / KEYWORD y」。
# 默认 1.0/0.0 = 纯语义；要「语义 0.3 + 关键词 0.7」就设 0.3 / 0.7。
# 两者都为 0 会被回退成 1.0/0.0（平台对全零权重返回空结果）。
KB_VECTOR_WEIGHT=1.0
KB_KEYWORD_WEIGHT=0.0

# ============================================================
# 意图识别 / 会话 / 启动预热
# ============================================================
# BGE 模型目录；留空则用 HuggingFace 的 BAAI/bge-small-zh-v1.5
INTENT_MODEL_PATH=/root/agentic-app/agent/intent/models/BAAI_bge-small-zh-v1.5
# 追问态 / 会话空闲回收（秒）
SESSION_TTL_SECONDS=1800
# 0 = 关闭启动预热（场景 MCP 握手）
PREWARM_ON_STARTUP=1
# 设备台账缓存秒数；留空用代码默认
DEVICE_CACHE_TTL=

# ============================================================
# Loop 链路灰度（agent/loop/rollout.py）
# ============================================================
# loop / legacy / auto，默认 auto
# AGENT_MODE=loop
# auto 模式下按 user:session 哈希取模的百分比
LOOP_ROLLOUT_PERCENT=
# 白名单，逗号分隔 user_id / session_id
LOOP_ROLLOUT_USERS=
# 0 = 关闭 MCP 工具动态发现（只用显式工具）
LOOP_DISCOVER=1

# ============================================================
# 评测脚本专用（tools/eval_intent.py，不参与线上运行）
# ============================================================
# NEG_MAX_FAIL_RATE=0.05
# ADV_MIN_PASS_RATE=0.90
# PERF_CONCURRENCY_N=8
# PERF_SLOTS_ROUNDS=20
